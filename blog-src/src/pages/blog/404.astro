---
import BlogLayout from '../../layouts/BlogLayout.astro';
---

<BlogLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="not-found">
    <h1>404</h1>
    <p>The page you're looking for doesn't exist.</p>
    <div class="not-found-links">
      <a href="/blog/">Back to Blog</a>
      <a href="/">Home</a>
    </div>
  </div>
</BlogLayout>

<style>
  .not-found {
    text-align: center;
    padding: 80px 0;
  }

  .not-found h1 {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 72px;
    font-weight: 700;
    color: #7c8594;
    margin-bottom: 8px;
    line-height: 1;
  }

  .not-found p {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 17px;
    color: #5f6b7a;
    margin-bottom: 32px;
  }

  .not-found-links {
    display: flex;
    gap: 20px;
    justify-content: center;
  }

  .not-found-links a {
    font-family: 'Roboto Mono', 'Roboto Mono Fallback', monospace;
    font-size: 13px;
    color: #1f6fa5;
    text-decoration: none;
    letter-spacing: 1px;
    padding: 8px 16px;
    border: 1px solid #1f6fa5;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .not-found-links a:hover {
    background: #1f6fa5;
    color: #fff;
  }

  :global([data-theme='dark']) .not-found h1 { color: #64748b; }
  :global([data-theme='dark']) .not-found p { color: #94a3b8; }
  :global([data-theme='dark']) .not-found-links a { color: #60a5fa; border-color: #60a5fa; }
  :global([data-theme='dark']) .not-found-links a:hover { background: #1a5276; border-color: #1a5276; color: #fff; }
</style>
