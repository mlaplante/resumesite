---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE_URL } from '../../../config';
import { byDateDesc } from '../../../utils/posts';
import { safeJsonLd, breadcrumbList } from '../../../utils/schema';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(post);
    }
  }
  return [...tagMap.entries()].map(([tag, tagPosts]) => ({
    params: { tag },
    props: {
      tag,
      posts: tagPosts.sort(byDateDesc),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
const siteUrl = SITE_URL;

const breadcrumbSchema = safeJsonLd(breadcrumbList([
  { name: 'Home', item: siteUrl },
  { name: 'Blog', item: `${siteUrl}/blog/` },
  { name: tag, item: `${siteUrl}/blog/tags/${tag}/` },
]));
---

<BlogLayout
  title={`Tag: ${tag}`}
  description={`${posts.length} post${posts.length === 1 ? '' : 's'} tagged "${tag}".`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={breadcrumbSchema} />
  </Fragment>
  <div class="listing-wrapper">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: tag }]} />

    <h1>Tag: <span class="taxonomy-name">{tag}</span></h1>
    <p class="taxonomy-count">{posts.length} post{posts.length === 1 ? '' : 's'}</p>

    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} badge="tags" />)}
    </div>

    <div class="back-link">
      <a href="/blog/">&larr; All posts</a>
    </div>
  </div>
</BlogLayout>

<style>
  .listing-wrapper {
    max-width: 720px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .listing-wrapper { max-width: 900px; }
  }

  h1 {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 4px;
  }

  .taxonomy-name { color: #1f6fa5; }

  .taxonomy-count {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 15px;
    color: #5f6b7a;
    margin-bottom: 32px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .post-grid { grid-template-columns: 1fr 1fr; }
  }

  .back-link {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
  }

  .back-link a {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1f6fa5;
    text-decoration: none;
  }

  .back-link a:hover { opacity: 0.7; }

  /* Dark mode keys off the manual toggle's data-theme attribute (see
     public/js/theme.js), never prefers-color-scheme alone. */
  :global([data-theme='dark']) h1 { color: #f1f5f9; }
  :global([data-theme='dark']) .taxonomy-name { color: #60a5fa; }
  :global([data-theme='dark']) .taxonomy-count { color: #94a3b8; }
  :global([data-theme='dark']) .back-link { border-top-color: #334155; }
  :global([data-theme='dark']) .back-link a { color: #60a5fa; }
</style>
