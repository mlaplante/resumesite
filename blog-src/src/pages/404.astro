---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="404 - Page Not Found" description="The page you're looking for doesn't exist.">
  <Fragment slot="head">
    <link rel="stylesheet" type="text/css" href="/css/fonts.css" />
    <link rel="stylesheet" type="text/css" href="/css/style.css" />
  </Fragment>
  <main class="not-found">
    <h1>404</h1>
    <p class="not-found-message">Page not found</p>
    <p class="not-found-description">The page you're looking for doesn't exist or has been moved.</p>
    <div class="not-found-links">
      <a href="/">Home</a>
      <a href="/blog/">Blog</a>
      <a href="/#contact">Contact</a>
    </div>
  </main>
</SiteLayout>

<style>
  .not-found {
    text-align: center;
    padding: 120px 20px;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .not-found h1 {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 96px;
    font-weight: 700;
    color: #7c8594;
    margin: 0;
    line-height: 1;
  }

  .not-found-message {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #374151;
    margin: 16px 0 8px;
  }

  .not-found-description {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 16px;
    color: #5f6b7a;
    margin: 0 0 40px;
  }

  .not-found-links {
    display: flex;
    gap: 16px;
  }

  .not-found-links a {
    font-family: 'Poppins', 'Poppins Fallback', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #1f6fa5;
    text-decoration: none;
    padding: 10px 24px;
    border: 2px solid #1f6fa5;
    border-radius: 8px;
    transition: all 0.2s;
  }

  .not-found-links a:hover {
    background: #1f6fa5;
    color: #fff;
  }

  :global([data-theme='dark']) .not-found h1 { color: #64748b; }
  :global([data-theme='dark']) .not-found-message { color: #e2e8f0; }
  :global([data-theme='dark']) .not-found-description { color: #94a3b8; }
  :global([data-theme='dark']) .not-found-links a { color: #60a5fa; border-color: #60a5fa; }
  :global([data-theme='dark']) .not-found-links a:hover { background: #1a5276; border-color: #1a5276; color: #fff; }
</style>
