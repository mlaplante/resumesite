{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/blog/index.html",
        "http://localhost/blog/hello-world/index.html",
        "http://localhost/blog/category/career/index.html",
        "http://localhost/blog/tags/security/index.html",
        "http://localhost/services/index.html",
        "http://localhost/resume/index.html",
        "http://localhost/uses/index.html",
        "http://localhost/privacy/index.html",
        "http://localhost/security/index.html",
        "http://localhost/404.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    }
  }
}
